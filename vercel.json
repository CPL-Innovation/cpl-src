{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path(.*)", "destination": "/api?__path=:path" },
    { "source": "/admin", "destination": "/admin/index.html" }
  ]
}
